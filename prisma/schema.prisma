// ─── Etiquetas (m:n explícita) ───────────────────────────────────────────────

model Tag {
  id        String   @id @default(cuid())
  userId    String   @db.Uuid
  name      String
  color     String?
  createdAt DateTime @default(now())

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions TransactionTag[]

  @@unique([userId, name])
  @@map("tags")
}

model TransactionTag {
  transactionId String
  tagId         String

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  tag         Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([transactionId, tagId])
  @@index([tagId])
  @@map("transaction_tags")
}

// ─── Transacciones recurrentes (plantilla + motor de generación) ─────────────

model RecurringRule {
  id          String          @id @default(cuid())
  userId      String          @db.Uuid
  accountId   String
  categoryId  String?
  name        String          // "Netflix", "Nómina"
  type        TransactionType
  amount      Decimal         @db.Decimal(19, 4) // con signo, igual que Transaction
  currency    String          @db.Char(3)
  description String?

  frequency  Frequency
  interval   Int       @default(1)   // cada N periodos
  dayOfMonth Int?      @db.SmallInt  // 1..31 (se ajusta al último día si no existe)
  dayOfWeek  Int?      @db.SmallInt  // 0..6
  startDate  DateTime  @db.Date
  endDate    DateTime? @db.Date
  nextRunAt  DateTime  @db.Date
  autoPost   Boolean   @default(true) // false = crea en PENDING para confirmar
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  transactions Transaction[]

  @@index([isActive, nextRunAt]) // consulta del cron
  @@index([userId])
  @@map("recurring_rules")
}

// ─── Presupuestos ────────────────────────────────────────────────────────────

model Budget {
  id             String       @id @default(cuid())
  userId         String       @db.Uuid
  categoryId     String       // incluye subcategorías al calcular el consumo
  period         BudgetPeriod @default(MONTHLY)
  amount         Decimal      @db.Decimal(19, 4) // en moneda base
  alertThreshold Decimal      @default(0.80) @db.Decimal(3, 2) // 0.80 = 80 %
  rollover       Boolean      @default(false) // arrastra sobrante al siguiente periodo
  startDate      DateTime     @db.Date
  endDate        DateTime?    @db.Date
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  alerts   BudgetAlert[]

  @@unique([userId, categoryId, period, startDate])
  @@map("budgets")
}

// Registro de alertas emitidas (evita notificar dos veces el mismo umbral/periodo)
model BudgetAlert {
  id          String   @id @default(cuid())
  budgetId    String
  periodStart DateTime @db.Date
  threshold   Decimal  @db.Decimal(3, 2) // 0.80, 1.00
  triggeredAt DateTime @default(now())
  readAt      DateTime?

  budget Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@unique([budgetId, periodStart, threshold])
  @@map("budget_alerts")
}

// ─── Metas de ahorro ─────────────────────────────────────────────────────────

model SavingsGoal {
  id               String     @id @default(cuid())
  userId           String     @db.Uuid
  linkedAccountId  String?    // si se vincula, el progreso = balance de la cuenta
  name             String
  targetAmount     Decimal    @db.Decimal(19, 4)
  currency         String     @db.Char(3)
  targetDate       DateTime?  @db.Date
  monthlyPlan      Decimal?   @db.Decimal(19, 4) // aporte mensual planificado
  status           GoalStatus @default(ACTIVE)
  color            String?
  icon             String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedAccount Account?           @relation(fields: [linkedAccountId], references: [id], onDelete: SetNull)
  contributions GoalContribution[]

  @@index([userId, status])
  @@map("savings_goals")
}

model GoalContribution {
  id            String   @id @default(cuid())
  goalId        String
  transactionId String?  // opcional: aporte respaldado por una transacción real
  amount        Decimal  @db.Decimal(19, 4)
  date          DateTime @db.Date
  note          String?
  createdAt     DateTime @default(now())

  goal        SavingsGoal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([goalId, date])
  @@map("goal_contributions")
}

// ─── Motor de auto-categorización ────────────────────────────────────────────

model CategorizationRule {
  id         String     @id @default(cuid())
  userId     String     @db.Uuid
  categoryId String
  field      RuleField  @default(PAYEE)
  match      RuleMatch  @default(CONTAINS)
  pattern    String     // normalizado (lowercase, sin acentos) salvo REGEX
  priority   Int        @default(100) // menor = se evalúa antes
  source     RuleSource @default(USER)
  hitCount   Int        @default(0)
  lastHitAt  DateTime?
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, isActive, priority])
  @@map("categorization_rules")
}

// ─── Tipos de cambio (multimoneda) ───────────────────────────────────────────

model ExchangeRate {
  base   String   @db.Char(3)
  quote  String   @db.Char(3)
  date   DateTime @db.Date
  rate   Decimal  @db.Decimal(19, 8)
  source String   @default("ecb")

  @@id([base, quote, date])
  @@map("exchange_rates")
}
